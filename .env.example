# ==============================================================================
# DOCUVAULT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to:
#   1. backend/.env (for Express server)
#   2. frontend/.env (for Vite React frontend)
# Fill in your project-specific credentials from your Supabase dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND ENVIRONMENT VARIABLES (backend/.env)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Frontend Application URL (for CORS allowance)
# Local development: http://localhost:5173
# Production: https://your-docuvault-frontend.vercel.app
FRONTEND_URL=http://localhost:5173

# Supabase Project Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Use Service Role Key for backend administrative operations (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Anon key for user-context validation
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Supabase Storage Bucket Name
SUPABASE_STORAGE_BUCKET=documents

# Maximum Upload File Size in Megabytes (default: 50MB)
MAX_FILE_SIZE_MB=50

# Storage quota per user in Megabytes (default: 500MB)
USER_STORAGE_QUOTA_MB=500

# ------------------------------------------------------------------------------
# FRONTEND ENVIRONMENT VARIABLES (frontend/.env)
# ------------------------------------------------------------------------------
# Note: Vite requires public client variables to begin with VITE_
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Backend API Base URL
# Local development: http://localhost:5000/api
# Production: https://your-docuvault-backend.onrender.com/api
VITE_API_BASE_URL=http://localhost:5000/api

# Application Display Name
VITE_APP_NAME=DocuVault
